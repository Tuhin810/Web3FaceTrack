# Copy to .env and fill in.  NEVER commit .env -- it is gitignored for a reason.
#
# Keys are validated per code path, not at import (DECISIONS.md D12): running with
# --provider offline needs none of them, which is what makes a clean-clone demo and CI
# possible without credentials.

# Reverse image search (needed only for --provider serpapi)
SERPAPI_KEY=

# Query-image hosting (needed only for --provider serpapi; 0x0.st is used as a fallback
# when this is unset, so it is optional even for live runs)
IMGBB_KEY=

# Chain RPC endpoints
RPC_URL_AMOY=https://rpc-amoy.polygon.technology
RPC_URL_LOCAL=http://127.0.0.1:8545

# Testnet-only key, never a real one. Needed only for `deploy` and `anchor`.
PRIVATE_KEY=

# Set after `facechain deploy` if you want to pin a specific deployment.
CONTRACT_ADDRESS=

# Pipeline tunables (see DECISIONS.md D6 for how MATCH_THRESHOLD was chosen)
MATCH_THRESHOLD=0.45
MAX_CANDIDATES=15
